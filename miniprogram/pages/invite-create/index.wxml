<view class="page">
  <view class="hero-section">
    <view class="hero-title">创建队伍</view>
    <view class="hero-subtitle">邀请好友组队，一起享受停车优惠</view>
  </view>

  <view class="team-info-section">
    <view class="section-title">队伍信息</view>
    <view class="team-id-row">
      <text class="label">队伍ID</text>
      <view class="id-area">
        <text class="id-value">{{teamId}}</text>
        <view class="copy-btn" bindtap="copyTeamId">📋 复制</view>
      </view>
    </view>
  </view>

  <view class="members-section">
    <view class="section-title">成员列表</view>
    <view class="members-list">
      <view class="member-item leader" wx:for="{{members}}" wx:key="id">
        <view class="member-avatar">{{item.avatar ? '' : '👤'}}</view>
        <view class="member-name">{{item.name}} <text wx:if="{{item.isLeader}}">（队长）</text></view>
      </view>
      <view class="member-item invite" bindtap="inviteFriend">
        <view class="member-avatar invite-avatar">+</view>
        <view class="member-name invite-text">邀请好友</view>
      </view>
    </view>
  </view>

  <view class="progress-section">
    <view class="section-title">招募进度</view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{(currentMembers / totalMembers) * 100}}%"></view>
    </view>
    <view class="progress-text">{{currentMembers}}/{{totalMembers}}人 {{currentMembers < totalMembers ? '· 招募中' : '· 已达标'}}</view>
  </view>

  <view class="invite-section">
    <view class="invite-card">
      <view class="invite-title">邀请好友组队说明</view>
      <view class="invite-desc">
        组队满3人后，队伍内所有成员均可获得停车优惠券！
      </view>
      <view class="invite-reward">
        <text class="reward-icon">🎁</text>
        <text class="reward-text">每人{{rewardInfo.count}}张¥{{rewardInfo.amount}}优惠券</text>
      </view>
    </view>
  </view>

  <view class="actions-section">
    <button class="invite-btn" bindtap="inviteFriend">📤 立即邀请</button>
    <button class="history-btn" bindtap="goToHistory">查看组队历史</button>
  </view>
</view>