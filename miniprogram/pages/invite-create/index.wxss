.page {
  min-height: 100vh;
  background: #F5F5F5;
}
.hero-section {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  padding: 50rpx 40rpx;
  text-align: center;
  color: #fff;
}
.hero-title {
  font-size: 40rpx;
  font-weight: bold;
}
.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.team-info-section, .members-section, .progress-section, .invite-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.team-id-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.label {
  font-size: 28rpx;
  color: #666;
}
.id-area {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.id-value {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E7EF0;
}
.copy-btn {
  font-size: 24rpx;
  color: #1E7EF0;
  padding: 6rpx 16rpx;
  background: #E8F1FF;
  border-radius: 8rpx;
}
.members-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx;
}
.member-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E8F1FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #1E7EF0;
}
.member-name {
  font-size: 24rpx;
  color: #333;
  margin-top: 8rpx;
  text-align: center;
}
.invite-avatar {
  background: #f0f0f0;
  color: #999;
}
.invite-text {
  color: #999;
}
.progress-bar {
  height: 16rpx;
  background: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1E7EF0, #1565D8);
  border-radius: 8rpx;
  transition: width 0.5s;
}
.progress-text {
  font-size: 28rpx;
  color: #666;
  margin-top: 12rpx;
}
.invite-card {
  background: linear-gradient(135deg, #FFF5E6, #FFEBCC);
  border-radius: 16rpx;
  padding: 30rpx;
  border: 2rpx solid #FFD699;
}
.invite-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}
.invite-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}
.invite-reward {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.reward-icon {
  font-size: 32rpx;
}
.reward-text {
  font-size: 26rpx;
  color: #FF8C00;
  font-weight: bold;
}
.actions-section {
  padding: 30rpx;
}
.invite-btn {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx;
  border-radius: 44rpx;
  border: none;
  margin-bottom: 20rpx;
}
.history-btn {
  background: #fff;
  color: #1E7EF0;
  font-size: 30rpx;
  padding: 20rpx;
  border-radius: 40rpx;
  border: 2rpx solid #1E7EF0;
}