.page {
  min-height: 100vh;
  background: #F5F5F5;
}
.hero-section {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
}
.hero-title {
  font-size: 44rpx;
  font-weight: bold;
}
.hero-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}
.team-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}
.team-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.team-empty {
  text-align: center;
  padding: 40rpx 0;
}
.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}
.team-actions {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}
.btn-primary {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  border: none;
}
.btn-secondary {
  background: #fff;
  color: #1E7EF0;
  font-size: 28rpx;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  border: 2rpx solid #1E7EF0;
}
.team-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.team-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 28rpx;
}
.team-label {
  color: #666;
}
.team-value {
  color: #333;
  font-weight: bold;
}
.history-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
}
.history-left {
  flex: 1;
}
.history-team {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.history-date {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.history-right {
  text-align: right;
}
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.status-tag.claimed {
  background: #E6F7EE;
  color: #07C160;
}
.status-tag.unclaimed {
  background: #FFF5E6;
  color: #FF8C00;
}
.history-amount {
  font-size: 24rpx;
  color: #1E7EF0;
  margin-top: 6rpx;
  font-weight: bold;
}