/* pages/my-vehicles/index.wxss */
.page { min-height: 100vh; background: #F5F5F5; padding-bottom: 120rpx; }
.vehicle-list { padding: 20rpx 24rpx; }
.vehicle-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; display: flex; align-items: center; justify-content: space-between; }
.vehicle-info { display: flex; align-items: center; flex: 1; }
.vehicle-plate { display: inline-block; background: #1E7EF0; color: #fff; font-size: 28rpx; padding: 8rpx 20rpx; border-radius: 8rpx; font-weight: bold; margin-right: 16rpx; }
.vehicle-default { display: inline-block; background: #FFF3E0; color: #FF8C00; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 12rpx; }
.vehicle-actions { display: flex; gap: 12rpx; }
.vehicle-btn { padding: 12rpx 20rpx; border-radius: 20rpx; font-size: 24rpx; }
.btn-default { background: #1E7EF0; color: #fff; }
.btn-delete { background: #FFE5E5; color: #FF4444; }
.add-btn { position: fixed; bottom: 40rpx; left: 50%; transform: translateX(-50%); background: #1E7EF0; color: #fff; padding: 20rpx 60rpx; border-radius: 40rpx; font-size: 28rpx; box-shadow: 0 4rpx 16rpx rgba(30,126,240,0.3); }
.empty-tip { text-align: center; padding: 100rpx 0; }
.empty-text { font-size: 28rpx; color: #999; }
.login-tip { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 120rpx 0; }
.login-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.login-text { font-size: 28rpx; color: #666; margin-bottom: 30rpx; }
.login-btn { background: #1E7EF0; color: #fff; padding: 20rpx 60rpx; border-radius: 40rpx; font-size: 28rpx; }