<view class="page">
  <block wx:if="{{!isLogin}}">
    <view class="login-header">
      <view class="avatar-placeholder">👤</view>
      <view class="login-info">
        <text class="login-title">点击登录</text>
        <text class="login-desc">登录后管理车辆、领取优惠券</text>
      </view>
      <view class="login-btn" bind:tap="goToLogin">立即登录</view>
    </view>
  </block>
  <block wx:else>
    <view class="user-header">
      <view class="avatar">{{userInfo.avatarUrl||'👤'}}</view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName||'种子用户'}}</text>
        <text class="user-phone">{{userInfo.phone}}</text>
      </view>
    </view>
  </block>

  <view class="menu-grid">
    <view class="menu-item" bind:tap="goToVehicles">
      <view class="menu-icon" style="background:#E8F2FF">🚗</view>
      <text class="menu-title">我的车辆</text>
      <text class="menu-desc">{{vehicleCount}}辆车</text>
    </view>
    <view class="menu-item" bind:tap="goToCoupons">
      <view class="menu-icon" style="background:#FFF3E0">🎫</view>
      <text class="menu-title">优惠券</text>
      <text class="menu-desc">{{couponCount}}张可用</text>
    </view>
    <view class="menu-item" bind:tap="goToCards">
      <view class="menu-icon" style="background:#FFF8E1">💳</view>
      <text class="menu-title">优惠卡</text>
      <text class="menu-desc">买得多省得多</text>
    </view>
    <view class="menu-item" bind:tap="goToPrivacy">
      <view class="menu-icon" style="background:#E8F5E9">🔒</view>
      <text class="menu-title">隐私政策</text>
      <text class="menu-desc">协议与隐私</text>
    </view>
    <view class="menu-item" bind:tap="goToPartner">
      <view class="menu-icon" style="background:#E3F2FD">🤝</view>
      <text class="menu-title">合作入驻</text>
      <text class="menu-desc">车场合作申请</text>
    </view>
    <view class="menu-item" bind:tap="goToCustomerService">
      <view class="menu-icon" style="background:#F3E5F5">🎧</view>
      <text class="menu-title">人工客服</text>
      <text class="menu-desc">在线客服</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-header">
      <view>
        <text class="section-title">优惠多多</text>
        <text class="section-desc">多重福利，停车更省钱</text>
      </view>
      <text class="section-link" bind:tap="goToActivityRules">活动规则 > </text>
    </view>
    <view class="promo-banner">
      <view class="promo-content">
        <text class="promo-title">新用户礼包</text>
        <view class="promo-tag">限时专享</view>
        <text class="promo-desc">最高可领30元停车优惠券</text>
      </view>
      <text class="promo-emoji">🎁</text>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">团队拼团拉新</view>
    <view class="team-section">
      <view class="team-content">
        <text class="team-desc">邀请好友加入，获取更多优惠</text>
      </view>
      <view class="team-btn" bind:tap="goToInvite">去邀请</view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">常见问题</view>
    <view class="faq-list">
      <view class="faq-item" bind:tap="goToFaq">
        <text>如何预约停车位？</text>
        <text class="arrow">›</text>
      </view>
      <view class="faq-item" bind:tap="goToFaq">
        <text>订单可以退款吗？</text>
        <text class="arrow">›</text>
      </view>
      <view class="faq-item" bind:tap="goToFaq">
        <text>优惠券怎么使用？</text>
        <text class="arrow">›</text>
      </view>
    </view>
    <text class="faq-more" bind:tap="goToFaq">查看更多问题 > </text>
  </view>

  <view class="section-card share-card">
    <view class="share-content">
      <text class="share-title">分享种子停车</text>
      <text class="share-desc">好友也能省</text>
      <text class="share-link">邀请拉新获得20元 > </text>
    </view>
    <text class="share-emoji">🎉</text>
  </view>
</view>
