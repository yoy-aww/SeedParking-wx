
.page { min-height: 100vh; background: #F5F5F5; padding-bottom: 20rpx; }
.login-header { display: flex; align-items: center; background: #fff; padding: 40rpx 24rpx; margin-bottom: 16rpx; }
.avatar-placeholder { width: 100rpx; height: 100rpx; border-radius: 50%; background: #E8F2FF; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin-right: 20rpx; }
.login-info { flex: 1; }
.login-title { font-size: 32rpx; font-weight: bold; color: #333; display: block; }
.login-desc { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.login-btn { background: #1E7EF0; color: #fff; font-size: 26rpx; padding: 16rpx 32rpx; border-radius: 30rpx; }
.user-header { display: flex; align-items: center; background: linear-gradient(135deg, #1E7EF0, #4A9CF5); padding: 40rpx 24rpx; margin-bottom: 16rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #fff; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin-right: 20rpx; }
.user-info { flex: 1; }
.user-name { font-size: 32rpx; font-weight: bold; color: #fff; display: block; }
.user-phone { font-size: 24rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 4rpx; }
.menu-grid { display: grid; grid-template-columns: repeat(3, 1fr); background: #fff; padding: 24rpx 16rpx; margin-bottom: 16rpx; gap: 16rpx; }
.menu-item { display: flex; flex-direction: column; align-items: center; padding: 16rpx; }
.menu-icon { width: 72rpx; height: 72rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-bottom: 8rpx; }
.menu-title { font-size: 24rpx; color: #333; font-weight: 500; }
.menu-desc { font-size: 20rpx; color: #999; margin-top: 2rpx; }
.section-card { background: #fff; padding: 24rpx; margin-bottom: 16rpx; border-radius: 16rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.section-desc { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.section-link { font-size: 24rpx; color: #1E7EF0; }
.promo-banner { display: flex; align-items: center; background: linear-gradient(135deg, #1E7EF0, #4A9CF5); padding: 28rpx; border-radius: 16rpx; }
.promo-content { flex: 1; }
.promo-title { color: #fff; font-size: 32rpx; font-weight: bold; }
.promo-tag { display: inline-block; background: #FF8C00; color: #fff; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 12rpx; margin-left: 12rpx; }
.promo-desc { color: rgba(255,255,255,0.9); font-size: 22rpx; display: block; margin-top: 8rpx; }
.promo-emoji { font-size: 60rpx; }
.team-section { display: flex; align-items: center; justify-content: space-between; margin-top: 12rpx; }
.team-desc { font-size: 24rpx; color: #666; }
.team-btn { background: #1E7EF0; color: #fff; font-size: 26rpx; padding: 14rpx 28rpx; border-radius: 28rpx; }
.faq-list { display: flex; flex-direction: column; }
.faq-item { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f5f5f5; font-size: 26rpx; color: #333; }
.arrow { color: #999; }
.faq-more { font-size: 24rpx; color: #1E7EF0; display: block; margin-top: 12rpx; text-align: center; }
.share-card { display: flex; align-items: center; justify-content: space-between; }
.share-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.share-desc { font-size: 22rpx; color: #999; display: block; margin-top: 4rpx; }
.share-link { font-size: 24rpx; color: #1E7EF0; display: block; margin-top: 8rpx; }
.share-emoji { font-size: 60rpx; }
