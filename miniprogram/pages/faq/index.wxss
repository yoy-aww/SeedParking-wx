.page {
  min-height: 100vh;
  background: #F5F5F5;
}
.intro-section {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
}
.intro-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.intro-title {
  font-size: 40rpx;
  font-weight: bold;
}
.intro-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}
.faq-list {
  padding: 20rpx;
}
.faq-category {
  margin-bottom: 20rpx;
}
.category-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #1E7EF0;
  padding: 16rpx 0;
  margin-bottom: 10rpx;
}
.faq-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
}
.faq-q {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  gap: 16rpx;
}
.q-icon {
  width: 40rpx;
  height: 40rpx;
  background: #1E7EF0;
  color: #fff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.q-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}
.arrow {
  font-size: 36rpx;
  color: #ccc;
  transition: transform 0.3s;
}
.arrow.expanded {
  transform: rotate(90deg);
}
.faq-a {
  display: none;
  flex-direction: row;
  padding: 0 30rpx 24rpx;
  gap: 16rpx;
}
.faq-a.show {
  display: flex;
}
.a-icon {
  width: 40rpx;
  height: 40rpx;
  background: #FF8C00;
  color: #fff;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}
.a-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}