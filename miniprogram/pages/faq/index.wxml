<view class="page">
  <view class="intro-section">
    <view class="intro-icon">🤔</view>
    <view class="intro-title">常见问题</view>
    <view class="intro-desc">没有找到答案？联系客服：400-XXX-XXXX</view>
  </view>

  <view class="faq-list">
    <view class="faq-category" wx:for="{{categories}}" wx:key="id">
      <view class="category-title">{{item.name}}</view>
      <view class="faq-item" wx:for="{{item.items}}" wx:for-item="faq" wx:for-index="faqIndex" wx:key="q">
        <view class="faq-q" data-id="{{item.id}}-{{faqIndex}}" bindtap="toggle">
          <text class="q-icon">Q</text>
          <text class="q-text">{{faq.q}}</text>
          <text class="arrow {{expanded[item.id + '-' + faqIndex] ? 'expanded' : ''}}">›</text>
        </view>
        <view class="faq-a {{expanded[item.id + '-' + faqIndex] ? 'show' : ''}}">
          <text class="a-icon">A</text>
          <text class="a-text">{{faq.a}}</text>
        </view>
      </view>
    </view>
  </view>
</view>