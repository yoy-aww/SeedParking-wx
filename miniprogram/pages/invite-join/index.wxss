.page {
  min-height: 100vh;
  background: #F5F5F5;
}
.hero-section {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  padding: 50rpx 40rpx;
  text-align: center;
  color: #fff;
}
.hero-title {
  font-size: 40rpx;
  font-weight: bold;
}
.hero-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.input-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.team-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 32rpx;
  text-align: center;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}
.input-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}
.join-btn {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  color: #fff;
  font-size: 32rpx;
  padding: 24rpx;
  border-radius: 44rpx;
  border: none;
  margin-top: 30rpx;
}
.join-btn.disabled {
  background: #ccc;
}
.history-section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
}
.history-left {
  flex: 1;
}
.history-team {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.history-date {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.status-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.status-tag.claimed {
  background: #E6F7EE;
  color: #07C160;
}
.status-tag.unclaimed {
  background: #FFF5E6;
  color: #FF8C00;
}