
.page { min-height: 100vh; background: #F5F5F5; }
.header { background: #1E7EF0; padding: 24rpx 24rpx 32rpx; }
.header-inner { display: flex; justify-content: space-between; align-items: center; }
.city-bar { display: flex; align-items: center; background: rgba(255,255,255,0.15); padding: 12rpx 24rpx; border-radius: 30rpx; }
.city-icon { color: #fff; font-size: 28rpx; margin-right: 8rpx; }
.city-text { color: #fff; font-size: 28rpx; }
.city-arrow { color: #fff; font-size: 24rpx; margin-left: 8rpx; opacity: 0.7; }

.category-section { background: #fff; margin: -16rpx 0 0; border-radius: 24rpx; padding: 24rpx; }
.category-list { display: flex; justify-content: space-around; }
.category-item { display: flex; flex-direction: column; align-items: center; padding: 12rpx; }
.category-icon-wrap { width: 88rpx; height: 88rpx; border-radius: 24rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 8rpx; }
.category-icon { font-size: 40rpx; }
.category-name { font-size: 24rpx; color: #333; font-weight: 500; }
.category-desc { font-size: 20rpx; color: #999; margin-top: 4rpx; }

.banner-section { padding: 24rpx; }
.banner-card { display: flex; align-items: center; padding: 32rpx; border-radius: 16rpx; }
.banner-content { flex: 1; }
.banner-title { color: #fff; font-size: 36rpx; font-weight: bold; }
.banner-tag { display: inline-block; background: #FF8C00; color: #fff; font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 16rpx; margin-top: 8rpx; }
.banner-subtitle { color: #fff; font-size: 24rpx; opacity: 0.9; margin-top: 8rpx; display: block; }
.banner-emoji { font-size: 80rpx; }

.recommend-section { padding: 0 24rpx 24rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; }
.section-more { font-size: 24rpx; color: #666; }
.lot-list { display: flex; flex-direction: column; gap: 20rpx; }
.lot-card { display: flex; background: #fff; border-radius: 16rpx; padding: 20rpx; }
.lot-image { width: 180rpx; height: 140rpx; background: #f0f0f0; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; position: relative; }
.lot-image-text { font-size: 48rpx; }
.lot-tag-green { position: absolute; bottom: 8rpx; left: 8rpx; background: #07C160; color: #fff; font-size: 18rpx; padding: 4rpx 8rpx; border-radius: 8rpx; }
.lot-info { flex: 1; padding: 0 16rpx; display: flex; flex-direction: column; justify-content: center; }
.lot-name { font-size: 26rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.lot-meta { display: flex; gap: 16rpx; margin-bottom: 8rpx; }
.lot-distance { font-size: 22rpx; color: #666; }
.lot-transfer { font-size: 22rpx; color: #FF8C00; }
.lot-tags { display: flex; gap: 8rpx; }
.lot-tag { font-size: 20rpx; color: #1E7EF0; background: #E8F2FF; padding: 4rpx 12rpx; border-radius: 8rpx; }
.lot-action { display: flex; flex-direction: column; align-items: flex-end; justify-content: center; }
.lot-price { font-size: 36rpx; font-weight: bold; color: #FF8C00; }
.lot-unit { font-size: 22rpx; color: #FF8C00; }
.lot-btn { background: #1E7EF0; color: #fff; font-size: 24rpx; padding: 12rpx 28rpx; border-radius: 30rpx; margin-top: 8rpx; }
.loading { text-align: center; color: #999; font-size: 24rpx; padding: 20rpx; }
