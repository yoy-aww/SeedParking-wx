.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 140rpx;
}
.vip-header {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  padding: 60rpx 40rpx 80rpx;
  color: #fff;
  text-align: center;
}
.vip-crown {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.vip-title {
  font-size: 44rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
}
.vip-subtitle {
  font-size: 28rpx;
  opacity: 0.9;
  margin-top: 10rpx;
}
.vip-rights {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 40rpx;
  flex-wrap: wrap;
}
.right-item {
  font-size: 24rpx;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}
.card-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.vip-card {
  display: flex;
  align-items: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
  transition: all 0.3s;
}
.vip-card.selected {
  border-color: #1E7EF0;
  background: #E8F1FF;
}
.card-left {
  flex: 1;
}
.card-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.card-uses {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.card-right {
  text-align: right;
  margin-right: 40rpx;
}
.card-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #1E7EF0;
}
.card-savings {
  font-size: 22rpx;
  color: #FF8C00;
  background: #FFF5E6;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  display: inline-block;
  margin-top: 4rpx;
}
.card-check {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.card-check.checked {
  background: #1E7EF0;
  border-color: #1E7EF0;
}
.card-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}
.desc-item {
  margin-bottom: 8rpx;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.price-info {
  display: flex;
  align-items: baseline;
}
.price-label {
  font-size: 28rpx;
  color: #333;
}
.price-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1E7EF0;
}
.checkout-btn {
  background: linear-gradient(135deg, #FF8C00, #FF7300);
  color: #fff;
  font-size: 32rpx;
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}