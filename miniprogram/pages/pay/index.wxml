<view class="page">
  <view class="amount-section">
    <view class="amount-label">应付金额</view>
    <view class="amount-value">¥{{amount}}</view>
  </view>

  <view class="product-section" wx:if="{{order}}">
    <view class="product-name">{{order.productName}}</view>
    <view class="product-time" wx:if="{{order.createdAt}}">订单时间：{{order.createdAt}}</view>
  </view>

  <view class="detail-section" wx:if="{{order}}">
    <view class="info-title">订单详情</view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{order.orderNo}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">商品名称</text>
      <text class="info-value">{{order.productName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单状态</text>
      <text class="info-value">待支付</text>
    </view>
  </view>

  <view class="detail-section" wx:if="{{order}}">
    <view class="info-title">费用明细</view>
    <view class="info-row">
      <text class="info-label">商品金额</text>
      <text class="info-value">¥{{order.amount}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">优惠金额</text>
      <text class="info-value discount">-¥0</text>
    </view>
    <view class="info-row">
      <text class="info-label">实付金额</text>
      <text class="info-value">¥{{amount}}</text>
    </view>
  </view>

  <view class="payment-section">
    <view class="info-title">支付方式</view>
    <view class="payment-row {{paymentMethod === 'wechat' ? 'active' : ''}}" data-type="wechat" bindtap="choosePayment">
      <view class="payment-icon">💳</view>
      <view class="payment-name">微信支付</view>
      <view class="payment-check {{paymentMethod === 'wechat' ? 'checked' : ''}}">{{paymentMethod === 'wechat' ? '✓' : ''}}</view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="pay-info">
      <text class="pay-label">实付：</text>
      <text class="pay-value">¥{{amount}}</text>
    </view>
    <button class="pay-btn {{paying ? 'disabled' : ''}}" bindtap="doPay">
      {{paying ? '支付中...' : '立即支付'}}
    </button>
  </view>
</view>