<view class="page">
  <view class="amount-section">
    <view class="amount-label">应付金额</view>
    <view class="amount-value">¥{{total}}</view>
  </view>

  <view class="product-section">
    <view class="product-name">{{orderInfo.productName}}</view>
    <view class="product-desc">{{orderInfo.cardType}}</view>
  </view>

  <view class="info-section">
    <view class="info-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">商品名称</text>
      <text class="info-value">{{orderInfo.productName}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">卡类型</text>
      <text class="info-value">{{orderInfo.cardType}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">可用次数</text>
      <text class="info-value">{{orderInfo.availableUses}}次</text>
    </view>
    <view class="info-row">
      <text class="info-label">开通方式</text>
      <text class="info-value">{{orderInfo.activationType}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">订单类型</text>
      <text class="info-value">{{orderInfo.orderType}}</text>
    </view>
  </view>

  <view class="detail-section">
    <view class="info-title">费用明细</view>
    <view class="info-row">
      <text class="info-label">商品金额</text>
      <text class="info-value">¥{{total}}</text>
    </view>
    <div class="info-row">
      <text class="info-label">优惠</text>
      <text class="info-value discount">-¥0</text>
    </div>
  </view>

  <view class="payment-section">
    <view class="info-title">支付方式</view>
    <view class="payment-row {{selectedPayment === 'wechat' ? 'active' : ''}}" data-type="wechat" bindtap="selectPayment">
      <view class="payment-icon">💳</view>
      <view class="payment-name">微信支付</view>
      <view class="payment-check {{selectedPayment === 'wechat' ? 'checked' : ''}}">{{selectedPayment === 'wechat' ? '✓' : ''}}</view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="pay-info">
      <text class="pay-label">实付：</text>
      <text class="pay-value">¥{{total}}</text>
    </view>
    <button class="pay-btn" bindtap="submitOrder">立即支付</button>
  </view>
</view>