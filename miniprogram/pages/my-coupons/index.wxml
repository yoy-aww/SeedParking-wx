<view class="page">
  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="id"
      class="tab-item {{activeTab === item.id ? 'active' : ''}}"
      data-id="{{item.id}}" bindtap="switchTab">
      <text class="tab-name">{{item.name}}</text>
      <text wx:if="{{item.count > 0}}" class="tab-count">{{item.count}}</text>
    </view>
  </view>

  <view class="coupon-list">
    <view wx:if="{{coupons.length === 0}}" class="empty-tip">
      <view class="empty-icon">🎫</view>
      <view class="empty-text">暂无优惠券</view>
    </view>
    <coupon-card wx:for="{{coupons}}" wx:key="id"
      coupon="{{item}}"
      bind:use="goToUse" />
  </view>
</view>