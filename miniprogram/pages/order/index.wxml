<view class="page">
  <view class="stat-bar">
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">全部订单</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-num green">{{enteredCount}}</text>
      <text class="stat-label">已入场</text>
    </view>
  </view>
  <view class="tab-bar">
    <view class="tab-item {{activeTab===index?'active':''}}" wx:for="{{tabs}}" wx:key="id" data-id="{{item.id}}" bind:tap="switchTab">
      {{item.name}}
    </view>
  </view>
  <view class="order-list" wx:if="{{orders.length > 0}}">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-header">
        <text class="order-id">订单号: {{item.id}}</text>
        <text class="order-status {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <view class="order-body">
        <text class="order-lot">{{item.parkingName}}</text>
        <view class="order-info-row">
          <text class="order-info-label">车牌</text>
          <text class="order-info-value">{{item.plate}}</text>
        </view>
        <view class="order-info-row">
          <text class="order-info-label">时间</text>
          <text class="order-info-value">{{item.startTime}} ~ {{item.endTime}}</text>
        </view>
        <view class="order-info-row">
          <text class="order-info-label">金额</text>
          <text class="order-info-value price">¥{{item.amount}}</text>
        </view>
      </view>
    </view>
  </view>
  <empty-state wx:if="{{orders.length === 0 && !loading}}"
    title="{{emptyTitle}}"
    desc="{{emptyDesc}}"
    buttonText="去首页预约停车 >"
    showButton="{{true}}"
    bind:action="goToBooking"
  />
</view>
