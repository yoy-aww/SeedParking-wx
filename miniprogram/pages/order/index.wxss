
.page { min-height: 100vh; background: #F5F5F5; }
.stat-bar { display: flex; background: linear-gradient(135deg, #1E7EF0, #4A9CF5); padding: 40rpx 0; align-items: center; justify-content: center; gap: 80rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 48rpx; font-weight: bold; color: #fff; }
.stat-num.green { color: #07C160; }
.stat-label { font-size: 24rpx; color: rgba(255,255,255,0.8); margin-top: 4rpx; }
.stat-divider { width: 2rpx; height: 50rpx; background: rgba(255,255,255,0.3); }
.tab-bar { display: flex; background: #fff; padding: 0 8rpx; }
.tab-item { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #666; }
.tab-item.active { color: #1E7EF0; font-weight: bold; }
.order-list { padding: 16rpx 24rpx; }
.order-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.order-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16rpx; border-bottom: 1rpx solid #f0f0f0; margin-bottom: 16rpx; }
.order-id { font-size: 22rpx; color: #999; }
.order-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 16rpx; }
.order-body { display: flex; flex-direction: column; gap: 8rpx; }
.order-lot { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.order-info-row { display: flex; }
.order-info-label { font-size: 24rpx; color: #999; width: 80rpx; }
.order-info-value { font-size: 24rpx; color: #333; flex: 1; }
.order-info-value.price { color: #FF8C00; font-weight: bold; }
