/* pages/activity-rules/index.wxss */
.page { min-height: 100vh; background: #F5F5F5; padding-bottom: 40rpx; }
.rules-header { background: linear-gradient(135deg, #1E7EF0, #4A9CF5); padding: 40rpx 24rpx; text-align: center; }
.rules-title { font-size: 36rpx; font-weight: bold; color: #fff; display: block; }
.rules-desc { font-size: 24rpx; color: rgba(255,255,255,0.8); display: block; margin-top: 8rpx; }
.rules-list { padding: 20rpx 24rpx; }
.rule-card { background: #fff; border-radius: 16rpx; padding: 28rpx; margin-bottom: 20rpx; display: flex; align-items: flex-start; }
.rule-icon { width: 80rpx; height: 80rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-right: 20rpx; flex-shrink: 0; }
.rule-content { flex: 1; }
.rule-title { font-size: 30rpx; font-weight: bold; color: #333; display: block; margin-bottom: 8rpx; }
.rule-desc { font-size: 26rpx; color: #666; line-height: 1.6; }
.rules-footer { text-align: center; padding: 20rpx; }
.footer-text { font-size: 22rpx; color: #999; }