.page {
  min-height: 100vh;
  background: #F5F5F5;
}
.header {
  background: linear-gradient(135deg, #1E7EF0, #1565D8);
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
}
.title {
  font-size: 40rpx;
  font-weight: bold;
}
.date-box {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 24rpx 30rpx;
}
.date-row {
  display: flex;
  font-size: 26rpx;
  padding: 6rpx 0;
}
.date-label {
  color: #666;
  width: 160rpx;
}
.date-value {
  color: #333;
  font-weight: bold;
}
.content {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
}
.section {
  margin-bottom: 24rpx;
}
.section:last-child {
  margin-bottom: 0;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1E7EF0;
  margin-bottom: 12rpx;
}
.section-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-line;
}
.footer {
  background: #fff;
  margin: 20rpx;
  border-radius: 12rpx;
  padding: 30rpx;
  text-align: center;
}
.footer-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}
.footer-info {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}