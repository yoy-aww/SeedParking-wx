<view class="page">
  <view class="header">
    <view class="title">{{policy.title}}</view>
  </view>

  <view class="date-box">
    <view class="date-row">
      <text class="date-label">发布日期：</text>
      <text class="date-value">{{policy.publishDate}}</text>
    </view>
    <view class="date-row">
      <text class="date-label">生效日期：</text>
      <text class="date-value">{{policy.effectiveDate}}</text>
    </view>
    <view class="date-row">
      <text class="date-label">更新日期：</text>
      <text class="date-value">{{policy.updateDate}}</text>
    </view>
  </view>

  <view class="content">
    <view class="section" wx:for="{{policy.paragraphs}}" wx:key="title">
      <view class="section-title">{{item.title}}</view>
      <view class="section-content">{{item.content}}</view>
    </view>
  </view>

  <view class="footer">
    <view class="footer-title">开发者信息</view>
    <view class="footer-info">开发者：北京种子科技</view>
    <view class="footer-info">邮箱：app@seedparking.com</view>
    <view class="footer-info">电话：400-XXX-XXXX</view>
  </view>
</view>