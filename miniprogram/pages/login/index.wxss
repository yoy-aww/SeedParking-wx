.page {
  min-height: 100vh;
  background: #fff;
}

.brand-section {
  background: linear-gradient(135deg, #1E7EF0 0%, #4DA6FF 100%);
  padding: 60rpx 32rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.brand-logo {
  font-size: 72rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.brand-slogan {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
}

.welcome-card {
  margin: -32rpx 32rpx 32rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(30,126,240,0.12);
  position: relative;
  z-index: 1;
}

.welcome-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
  text-align: center;
}

.welcome-features {
  display: flex;
  gap: 16rpx;
}

.feature-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: #F0F7FF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.feature-name {
  font-size: 22rpx;
  color: #666666;
}

.login-form {
  padding: 0 32rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.input-wrapper {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e0e0e0;
  padding: 16rpx 0;
}

.input-prefix {
  font-size: 32rpx;
  color: #333333;
  padding-right: 16rpx;
  border-right: 1rpx solid #e0e0e0;
  margin-right: 16rpx;
  height: 40rpx;
  line-height: 40rpx;
}

.input-field {
  flex: 1;
  font-size: 32rpx;
  color: #333333;
  height: 40rpx;
}

.code-btn {
  font-size: 26rpx;
  color: #1E7EF0;
  padding: 8rpx 16rpx;
  white-space: nowrap;
}

.code-btn.disabled {
  color: #999999;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin: 32rpx 0;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ccc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.checkbox.checked {
  background: #1E7EF0;
  border-color: #1E7EF0;
}

.checkbox text {
  color: #fff;
  font-size: 24rpx;
}

.agree-text {
  font-size: 22rpx;
  color: #666666;
  line-height: 36rpx;
}

.agree-link {
  color: #1E7EF0;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #1E7EF0 0%, #4DA6FF 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  line-height: 96rpx;
}

.submit-btn.disabled {
  opacity: 0.5;
}

.skip-btn {
  text-align: center;
  padding: 32rpx;
  font-size: 26rpx;
  color: #999999;
}